# .env.example — Control de Pedidos NHERISA 3D
#
# Este archivo documenta las variables de entorno necesarias para el proyecto.
# NO contiene valores reales. Copiá este archivo como ".env" y completá los valores.
# El archivo ".env" real NUNCA debe subirse al repositorio.
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Configuración general ───────────────────────────────────────────────────

# Nombre de la aplicación (para referencia interna)
APP_NAME="Control de Pedidos NHERISA 3D"

# Versión actual de la aplicación
APP_VERSION="5.1.0"

# ─── Integraciones futuras (ejemplos de referencia) ──────────────────────────
# Si en el futuro se integra Google Sheets, Webhooks u otras APIs,
# las credenciales irán aquí — NUNCA en el código fuente.

# Ejemplo: Google Sheets API
# GOOGLE_SHEETS_API_KEY=tu_api_key_aqui
# GOOGLE_SHEETS_SPREADSHEET_ID=id_de_la_hoja_aqui

# Ejemplo: Webhook de notificaciones
# WEBHOOK_URL=https://hooks.ejemplo.com/tu-webhook

# Ejemplo: Servicio de backup en la nube
# CLOUD_BACKUP_TOKEN=tu_token_de_acceso_aqui
# CLOUD_BACKUP_ENDPOINT=https://api.ejemplo.com/backup

# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANTE: Nunca pongas valores reales en este archivo.
# Este archivo ES para documentación. El archivo ".env" es para valores reales.
# ─────────────────────────────────────────────────────────────────────────────
